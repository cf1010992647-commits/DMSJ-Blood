        <DropShadowEffect x:Key="CardShadowEffect"
                          BlurRadius="8"
                          Direction="270"
                          ShadowDepth="1"
                          Opacity="0.10"
                          Color="#000000" />

        <Style x:Key="PageTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
        </Style>

        <Style x:Key="IconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#EAF2FF" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTextStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0F172B" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#BFDBFE" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonBaseStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#314158" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#BFDBFE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="WriteButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="58" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="AxisTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{StaticResource PageBackgroundBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="24,24,0,24"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Effect="{StaticResource CardShadowEffect}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="65" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="{StaticResource WeakBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="16,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32"
                                                    Height="32"
                                                    Background="#EAF2FF"
                                                    CornerRadius="10"
                                                    Margin="0,0,8,0">
                                                <Path Data="{StaticResource AxisIconGeometry}"
                                                      Stroke="{StaticResource AccentBrush}"
                                                      StrokeThickness="1.35"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      Width="16"
                                                      Height="16" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PageTextStyle}"
                                                           Text="轴调试"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource PageTextStyle}"
                                                           Text="共 4 个轴 · 4 在线"
                                                           Margin="0,1,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TabPanel Grid.Row="1"
                                              Margin="8"
                                              IsItemsHost="True" />
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AxisTabItemStyle" TargetType="TabItem">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Padding="10,8"
                                Background="Transparent"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AxisBadge"
                                        Width="32"
                                        Height="32"
                                        Background="#F1F5F9"
                                        CornerRadius="8">
                                    <TextBlock x:Name="AxisShortText"
                                               Style="{StaticResource PageTextStyle}"
                                               Text="{TemplateBinding Tag}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#314158" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="HeaderPresenter"
                                                      ContentSource="Header"
                                                      TextElement.Foreground="#314158"
                                                      TextElement.FontSize="13"
                                                      TextElement.FontWeight="SemiBold" />
                                    <TextBlock x:Name="SubtitleText"
                                               Style="{StaticResource PageTextStyle}"
                                               Text="{TemplateBinding ToolTip}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="AxisBadge" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="AxisShortText" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="#1447E6" />
                                <Setter TargetName="SubtitleText" Property="Foreground" Value="#2B7FFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="StatusLampTemplate" DataType="{x:Type vm:AxisStatusLampViewModel}">
            <Border Height="26"
                    Margin="0,0,8,8"
                    Padding="10,0"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6"
                             Height="6"
                             Fill="{Binding Color}"
                             Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource PageTextStyle}"
                               Text="{Binding Name}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AxisCardTemplate" DataType="{x:Type vm:AxisControlCardViewModel}">
            <Grid Background="{StaticResource PageBackgroundBrush}" Margin="16,24,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CardStyle}"
                        Height="76"
                        Padding="20,0"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                Background="#EAF2FF"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                            <Path Data="{StaticResource PulseIconGeometry}"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="1.55"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource PageTextStyle}"
                                       Text="{Binding Title, StringFormat=轴调试 · {0}}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource PageTextStyle}"
                                       Text="运动参数与点位状态"
                                       Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource ButtonBaseStyle}"
                                Click="OpenAxisAddressConfig_Click"
                                Width="120"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ConfigIconGeometry}"
                                      Stroke="#314158"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="轴点位配置" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CardStyle}"
                                    MinHeight="166"
                                    Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource IconBadgeStyle}" Margin="0,0,8,0">
                                            <Path Data="{StaticResource OperationIconGeometry}"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"
                                                  Width="16"
                                                  Height="16" />
                                        </Border>
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="操作控制"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource ButtonBaseStyle}"
                                                Height="44"
                                                behaviors:ButtonPressBehavior.PressCommand="{Binding JogMinusPressCommand}"
                                                behaviors:ButtonPressBehavior.ReleaseCommand="{Binding JogMinusReleaseCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource LeftIconGeometry}"
                                                      Stroke="#314158"
                                                      StrokeThickness="1.35"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="0,0,6,0" />
                                                <TextBlock Text="JOG-" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Height="44"
                                                behaviors:ButtonPressBehavior.PressCommand="{Binding GoHomePressCommand}"
                                                behaviors:ButtonPressBehavior.ReleaseCommand="{Binding GoHomeReleaseCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource HomeIconGeometry}"
                                                      Stroke="#FFFFFF"
                                                      StrokeThickness="1.35"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="0,0,6,0" />
                                                <TextBlock Text="回原点" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="4"
                                                Style="{StaticResource ButtonBaseStyle}"
                                                Height="44"
                                                behaviors:ButtonPressBehavior.PressCommand="{Binding JogPlusPressCommand}"
                                                behaviors:ButtonPressBehavior.ReleaseCommand="{Binding JogPlusReleaseCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="JOG+" Margin="0,0,6,0" />
                                                <Path Data="{StaticResource RightIconGeometry}"
                                                      Stroke="#314158"
                                                      StrokeThickness="1.35"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      Width="16"
                                                      Height="16" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock Style="{StaticResource PageTextStyle}"
                                               Text="长按 JOG 按钮持续运动，松开即停止。"
                                               Margin="0,14,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource CardStyle}"
                                    MinHeight="166"
                                    Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource IconBadgeStyle}" Margin="0,0,8,0">
                                            <Path Data="{StaticResource SpeedIconGeometry}"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"
                                                  Width="16"
                                                  Height="16" />
                                        </Border>
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="状态概览"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding StatusLamps}"
                                                  ItemTemplate="{StaticResource StatusLampTemplate}"
                                                  Margin="0,16,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Style="{StaticResource CardStyle}"
                                    MinHeight="166"
                                    Padding="16"
                                    Visibility="{Binding ShowPositionFields, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource IconBadgeStyle}" Margin="0,0,8,0">
                                            <Path Data="{StaticResource PositionIconGeometry}"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"
                                                  Width="16"
                                                  Height="16" />
                                        </Border>
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="位置"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Height="72"
                                                Padding="12,10"
                                                Background="{StaticResource TileBackgroundBrush}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="当前位置" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Style="{StaticResource PageTextStyle}"
                                                               Text="{Binding CurrentPosition, Mode=OneWay}"
                                                               FontSize="20"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource PageTextStyle}"
                                                               Text="mm"
                                                               Margin="6,8,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2"
                                                Height="72"
                                                Padding="12,10"
                                                Background="{StaticResource TileBackgroundBrush}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="目标位置" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Style="{StaticResource PageTextStyle}"
                                                               Text="{Binding TargetPosition, Mode=OneWay}"
                                                               FontSize="20"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource PageTextStyle}"
                                                               Text="mm"
                                                               Margin="6,8,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,14,0,0"
                                          Visibility="{Binding ShowManualLocate, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="68" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource CaptionStyle}" Text="手动定位" />
                                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                                     Margin="0,6,0,0"
                                                     Text="{Binding ManualLocateInput, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="写入"
                                                Style="{StaticResource WriteButtonStyle}"
                                                VerticalAlignment="Bottom"
                                                behaviors:ButtonPressBehavior.PressCommand="{Binding ManualLocatePressCommand}"
                                                behaviors:ButtonPressBehavior.ReleaseCommand="{Binding ManualLocateReleaseCommand}" />
                                        <Button Grid.Column="4"
                                                Content="移动"
                                                Style="{StaticResource ButtonBaseStyle}"
                                                Padding="0"
                                                VerticalAlignment="Bottom"
                                                behaviors:ButtonPressBehavior.PressCommand="{Binding ManualLocatePressCommand}"
                                                behaviors:ButtonPressBehavior.ReleaseCommand="{Binding ManualLocateReleaseCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CardStyle}"
                                    Padding="16"
                                    MinHeight="176">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource IconBadgeStyle}" Margin="0,0,8,0">
                                            <Path Data="{StaticResource SpeedIconGeometry}"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"
                                                  Width="16"
                                                  Height="16" />
                                        </Border>
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="速度"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Height="72"
                                                    Padding="12,10"
                                                    Background="{StaticResource TileBackgroundBrush}"
                                                    BorderBrush="{StaticResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="当前手动速度" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                                   Text="{Binding ManualSpeed, Mode=OneWay}"
                                                                   FontSize="20"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                                   Text="mm/s"
                                                                   Margin="6,8,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="手动速度" />
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="58" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                                             Text="{Binding ManualSpeedInput, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="2"
                                                            Content="写入"
                                                            Style="{StaticResource WriteButtonStyle}"
                                                            Command="{Binding WriteManualSpeedCommand}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Height="72"
                                                    Padding="12,10"
                                                    Background="{StaticResource TileBackgroundBrush}"
                                                    BorderBrush="{StaticResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="当前自动速度" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                                   Text="{Binding AutoSpeed, Mode=OneWay}"
                                                                   FontSize="20"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                                   Text="mm/s"
                                                                   Margin="6,8,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="自动速度" />
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="58" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                                             Text="{Binding AutoSpeedInput, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="2"
                                                            Content="写入"
                                                            Style="{StaticResource WriteButtonStyle}"
                                                            Command="{Binding WriteAutoSpeedCommand}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource CardStyle}"
                                    Padding="16"
                                    MinHeight="176">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource IconBadgeStyle}" Margin="0,0,8,0">
                                            <Path Data="{StaticResource TimeIconGeometry}"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"
                                                  Width="16"
                                                  Height="16" />
                                        </Border>
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="加减速时间"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Height="72"
                                                    Padding="12,10"
                                                    Background="{StaticResource TileBackgroundBrush}"
                                                    BorderBrush="{StaticResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="当前加速时间" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                                   Text="{Binding AccelerationTime, Mode=OneWay}"
                                                                   FontSize="20"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                                   Text="ms"
                                                                   Margin="6,8,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="加速时间" />
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="58" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                                             Text="{Binding AccelerationTimeInput, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="2"
                                                            Content="写入"
                                                            Style="{StaticResource WriteButtonStyle}"
                                                            Command="{Binding WriteAccelerationTimeCommand}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Height="72"
                                                    Padding="12,10"
                                                    Background="{StaticResource TileBackgroundBrush}"
                                                    BorderBrush="{StaticResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="当前减速时间" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                                   Text="{Binding DecelerationTime, Mode=OneWay}"
                                                                   FontSize="20"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                                   Text="ms"
                                                                   Margin="6,8,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="减速时间" />
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="58" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                                             Text="{Binding DecelerationTimeInput, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="2"
                                                            Content="写入"
                                                            Style="{StaticResource WriteButtonStyle}"
                                                            Command="{Binding WriteDecelerationTimeCommand}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Height="46"
                        Margin="0,12,0,0"
                        Padding="20,0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Effect="{StaticResource CardShadowEffect}">
                    <DockPanel LastChildFill="True">
                        <Grid Width="14"
                              Height="14"
                              DockPanel.Dock="Left"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center">
                            <Ellipse Fill="#00D492" Opacity="0.40" />
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource SuccessBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource PageTextStyle}"
                                   Text="{Binding DataContext.ActionMessage, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#314158"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl Style="{StaticResource AxisTabControlStyle}"
                ItemContainerStyle="{StaticResource AxisTabItemStyle}"
                Background="{StaticResource PageBackgroundBrush}">
        <TabItem Header="X 轴伺服" Tag="X" ToolTip="M1 · 横向运动">
            <ContentControl Content="{Binding XAxis}"
                            ContentTemplate="{StaticResource AxisCardTemplate}" />
        </TabItem>
        <TabItem Header="Y 轴伺服" Tag="Y" ToolTip="M2 · 纵向运动">
            <ContentControl Content="{Binding YAxis}"
                            ContentTemplate="{StaticResource AxisCardTemplate}" />
        </TabItem>
        <TabItem Header="Z 轴伺服" Tag="Z" ToolTip="M3 · 升降运动">
            <ContentControl Content="{Binding ZAxis}"
                            ContentTemplate="{StaticResource AxisCardTemplate}" />
        </TabItem>
        <TabItem Header="摇匀轴" Tag="摇" ToolTip="M4 · 摇匀电机">
            <ContentControl Content="{Binding ShakeAxis}"
                            ContentTemplate="{StaticResource AxisCardTemplate}" />
        </TabItem>
    </TabControl>
</UserControl>
