<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Blood_Alcohol.Views.AxisSafePositionConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="初始化确认"
        Width="480"
        Height="286"
        MinWidth="480"
        MinHeight="286"
        MaxWidth="480"
        MaxHeight="286"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Inter, Segoe UI, Microsoft YaHei"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <DropShadowEffect x:Key="DialogShadowEffect"
                          BlurRadius="22"
                          Direction="270"
                          ShadowDepth="5"
                          Opacity="0.14"
                          Color="#000000" />

        <DrawingImage x:Key="FigmaDialogIconClose">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M12 4L4 12">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#62748E" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M4 4L12 12">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#62748E" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="FigmaDialogIconCloseDark">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M12 4L4 12">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#314158" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M4 4L12 12">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#314158" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="FigmaDialogIconAlert">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M14.4867 12L9.15333 2.66667C9.03704 2.46147 8.8684 2.29079 8.66462 2.17205C8.46083 2.0533 8.22919 1.99074 7.99333 1.99074C7.75747 1.99074 7.52584 2.0533 7.32205 2.17205C7.11826 2.29079 6.94962 2.46147 6.83333 2.66667L1.5 12C1.38245 12.2036 1.32082 12.4346 1.32134 12.6697C1.32186 12.9047 1.38452 13.1355 1.50296 13.3385C1.62141 13.5416 1.79143 13.7097 1.9958 13.8259C2.20016 13.942 2.4316 14.0021 2.66667 14H13.3333C13.5673 13.9998 13.797 13.938 13.9995 13.8209C14.202 13.7037 14.3701 13.5354 14.487 13.3327C14.6039 13.1301 14.6654 12.9003 14.6653 12.6663C14.6652 12.4324 14.6036 12.2026 14.4867 12Z M8 6V8.66667 M8 11.3333H8.00667">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F59E0B" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="FigmaDialogIconShieldBlue">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M13.3333 8.66667C13.3333 12 11 13.6667 8.22667 14.6333C8.08144 14.6825 7.92369 14.6802 7.78 14.6267C5 13.6667 2.66667 12 2.66667 8.66667V4C2.66667 3.82319 2.7369 3.65362 2.86193 3.5286C2.98695 3.40357 3.15652 3.33333 3.33333 3.33333C4.66667 3.33333 6.33333 2.53333 7.49333 1.52C7.63457 1.39933 7.81424 1.33303 8 1.33303C8.18576 1.33303 8.36543 1.39933 8.50667 1.52C9.67333 2.54 11.3333 3.33333 12.6667 3.33333C12.8435 3.33333 13.013 3.40357 13.1381 3.5286C13.2631 3.65362 13.3333 3.82319 13.3333 4V8.66667Z M6 8L7.33333 9.33333L10 6.66667">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#155DFC" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.90" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#155DFC" />
            <Setter Property="BorderBrush" Value="#155DFC" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="SecondaryDialogButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#314158" />
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Background="#FFFFFF"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource DialogShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#EEF2F7"
                    BorderThickness="0,0,0,1"
                    Padding="20,0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="32"
                                Height="32"
                                Background="#EFF6FF"
                                CornerRadius="8"
                                Margin="0,0,10,0">
                            <Image Width="18"
                                   Height="18"
                                   Source="{StaticResource FigmaDialogIconShieldBlue}" />
                        </Border>
                        <TextBlock Text="初始化系统确认"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                    </StackPanel>
                    <Button Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelButton_Click">
                        <Image Width="16"
                               Height="16"
                               Source="{StaticResource FigmaDialogIconClose}" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="28,22,28,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="48"
                        Height="48"
                        Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="12"
                        VerticalAlignment="Top">
                    <Image Width="28"
                           Height="28"
                           Source="{StaticResource FigmaDialogIconAlert}" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="4,0,0,0">
                    <TextBlock Text="请确认轴是否处于安全位置"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="点击“是”将继续执行系统初始化"
                               Margin="0,11,0,0"
                               FontSize="13"
                               Foreground="#475569"
                               TextWrapping="Wrap" />
                    <TextBlock Text="点击“否”或关闭窗口将取消本次初始化"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="#64748B"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#EEF2F7"
                    BorderThickness="0,1,0,0"
                    Padding="20,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryDialogButtonStyle}"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16"
                                   Height="16"
                                   Margin="0,0,6,0"
                                   Source="{StaticResource FigmaDialogIconCloseDark}" />
                            <TextBlock Text="否" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryDialogButtonStyle}"
                            Content="是"
                            Click="ConfirmButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
