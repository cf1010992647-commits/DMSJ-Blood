<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Blood_Alcohol.Views.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Blood_Alcohol.Views"
             xmlns:vm="clr-namespace:Blood_Alcohol.ViewModels"
             FontFamily="Segoe UI,Microsoft YaHei"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.DataContext>
        <vm:DebugViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="DebugBackgroundBrush" Color="#F2F2F7" />
        <SolidColorBrush x:Key="DebugChromeBrush" Color="#F8F8FA" />
        <SolidColorBrush x:Key="DebugBorderBrush" Color="#E5E5EA" />
        <SolidColorBrush x:Key="DebugPrimaryBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="DebugTextBrush" Color="#1D1D1F" />
        <SolidColorBrush x:Key="DebugMutedTextBrush" Color="#6E6E73" />
        <SolidColorBrush x:Key="DebugHintBrush" Color="#EEF6FF" />

        <Style x:Key="DebugTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Margin="18,0,18,12"
                                    Padding="6"
                                    Background="{StaticResource DebugChromeBrush}"
                                    BorderBrush="{StaticResource DebugBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <TabPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{StaticResource DebugBackgroundBrush}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DebugTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource DebugMutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Height="{TemplateBinding Height}"
                                MinWidth="{TemplateBinding MinWidth}"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="10">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource DebugTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource DebugPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource DebugBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="18,14,18,12"
                Padding="14,10"
                Background="{StaticResource DebugHintBrush}"
                BorderBrush="#D7E9FF"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse Width="8"
                         Height="8"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource DebugPrimaryBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ModeHintText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource DebugMutedTextBrush}" />
            </Grid>
        </Border>

        <TabControl x:Name="DebugTabControl"
                    Grid.Row="1"
                    Style="{StaticResource DebugTabControlStyle}"
                    ItemContainerStyle="{StaticResource DebugTabItemStyle}"
                    SelectionChanged="DebugTabControl_OnSelectionChanged"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="轴运动调试"
                     IsEnabled="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     IsHitTestVisible="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <views:AxisDebugView />
            </TabItem>
            <TabItem Header="点位监控">
                <views:PointMonitorView />
            </TabItem>
            <TabItem Header="故障调试"
                     IsEnabled="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     IsHitTestVisible="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <views:FaultDebugView />
            </TabItem>
            <TabItem Header="坐标调试"
                     IsEnabled="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     IsHitTestVisible="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <views:CoordinateDebugView />
            </TabItem>
            <TabItem Header="系数配置"
                     IsEnabled="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     IsHitTestVisible="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <views:WeightToZDebugView />
            </TabItem>
            <TabItem Header="参数配置"
                     IsEnabled="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     IsHitTestVisible="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <views:ParameterConfigView />
            </TabItem>
            <TabItem Header="气缸控制"
                     IsEnabled="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     IsHitTestVisible="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <views:CylinderControlView />
            </TabItem>
            <TabItem Header="原工位控制"
                     IsEnabled="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     IsHitTestVisible="{Binding DataContext.IsManualMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <views:PointPositionControlView />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
