        <Style x:Key="WeightCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect" Value="{StaticResource WeightCardShadow}" />
        </Style>

        <Style x:Key="SectionIconBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#EAF1FF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="106" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#314158" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="#155DFC" />
            <Setter Property="BorderBrush" Value="#155DFC" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#0A0A0A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#155DFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="24,24,24,0" Padding="24,20" Style="{StaticResource WeightCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" Background="#EAF1FF" CornerRadius="10" Margin="0,0,12,0">
                        <Image Width="20" Height="20" Source="{StaticResource WeightIconSigmaBlue}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="重量 → Z轴系数调试" Foreground="#0F172B" FontSize="16" LineHeight="24" />
                        <TextBlock Text="采集重量与坐标 · 计算 Z 轴 / 微升换算系数" Foreground="#62748E" FontSize="14" LineHeight="20" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Z 系数" Foreground="#62748E" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ZPerWeight, StringFormat={}{0:F6}}" Foreground="#0F172B" FontSize="16" Margin="8,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="ul 系数" Foreground="#62748E" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MicroliterPerWeight, StringFormat={}{0:F6}}" Foreground="#0F172B" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,12,24,0" Padding="20,12" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="14">
            <StackPanel Orientation="Horizontal">
                <Image Width="16" Height="16" Source="{StaticResource WeightIconPulseBlue}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#314158" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,16">
                <Border Style="{StaticResource WeightCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SectionIconBoxStyle}">
                                    <Image Width="16" Height="16" Source="{StaticResource WeightIconRulerBlue}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="重量转 Z 轴系数" Foreground="#0F172B" FontSize="16" LineHeight="24" />
                                    <TextBlock Text="获取当前重量与 Z 轴坐标后计算 mm/g 比例系数" Foreground="#62748E" FontSize="14" LineHeight="20" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="20">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding ReadCurrentWeightCommand}" Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Source="{StaticResource WeightIconScaleDark}" Margin="0,0,8,0" />
                                        <TextBlock Text="获取重量" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding ReadCurrentZCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="164">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Source="{StaticResource WeightIconRulerDark}" Margin="0,0,8,0" />
                                        <TextBlock Text="获取当前 Z 轴位置" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Command="{Binding ComputeCoefficientCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="136">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Source="{StaticResource WeightIconCalcDark}" Margin="0,0,8,0" />
                                        <TextBlock Text="计算 Z 轴系数" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="6" Command="{Binding AcquireAndComputeCoefficientCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="132">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Source="{StaticResource WeightIconLightningWhite}" Margin="0,0,8,0" />
                                        <TextBlock Text="一键采集计算" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="重量" Foreground="#62748E" FontSize="14" />
                                            <Border Width="28" Height="28" Background="#F1F5F9" CornerRadius="8" HorizontalAlignment="Right">
                                                <Image Width="16" Height="16" Source="{StaticResource WeightIconScaleSlate}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding CurrentWeight, StringFormat={}{0:F3}}" Foreground="#0F172B" FontSize="24" LineHeight="36" />
                                            <TextBlock Text="g" Foreground="#90A1B9" FontSize="14" Margin="8,12,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="Z 轴坐标" Foreground="#62748E" FontSize="14" />
                                            <Border Width="28" Height="28" Background="#F1F5F9" CornerRadius="8" HorizontalAlignment="Right">
                                                <Image Width="16" Height="16" Source="{StaticResource WeightIconRulerSlate}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding CurrentZ, StringFormat={}{0:F3}}" Foreground="#0F172B" FontSize="24" LineHeight="36" />
                                            <TextBlock Text="mm" Foreground="#90A1B9" FontSize="14" Margin="8,12,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="4" BorderBrush="#BEDBFF" BorderThickness="1" CornerRadius="14" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="重量转 Z 系数" Foreground="#62748E" FontSize="14" />
                                            <Border Width="28" Height="28" Background="#EAF1FF" CornerRadius="8" HorizontalAlignment="Right">
                                                <Image Width="16" Height="16" Source="{StaticResource WeightIconSigmaSmallBlue}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding ZPerWeight, StringFormat={}{0:F6}}" Foreground="#155DFC" FontSize="24" LineHeight="36" />
                                            <TextBlock Text="mm/g" Foreground="#90A1B9" FontSize="14" Margin="8,12,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource WeightCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SectionIconBoxStyle}">
                                    <Image Width="16" Height="16" Source="{StaticResource WeightIconDropletBlue}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="重量转微升系数" Foreground="#0F172B" FontSize="16" LineHeight="24" />
                                    <TextBlock Text="读取重量并输入对应微升值，计算 ul/g 比例系数" Foreground="#62748E" FontSize="14" LineHeight="20" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="20">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="144" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding ReadCurrentWeightCommand}" Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Source="{StaticResource WeightIconScaleDark}" Margin="0,0,8,0" />
                                        <TextBlock Text="获取重量" />
                                    </StackPanel>
                                </Button>

                                <TextBox Grid.Column="2"
                                         Text="{Binding InputMicroliter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}"
                                         Style="{StaticResource InputBoxStyle}" />
                                <TextBlock Grid.Column="4" Text="ul" Foreground="#62748E" FontSize="14" VerticalAlignment="Center" />

                                <Button Grid.Column="6" Command="{Binding ComputeMicroliterCoefficientCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="174">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Source="{StaticResource WeightIconCalcDark}" Margin="0,0,8,0" />
                                        <TextBlock Text="计算重量转微升系数" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="重量" Foreground="#62748E" FontSize="14" />
                                            <Border Width="28" Height="28" Background="#F1F5F9" CornerRadius="8" HorizontalAlignment="Right">
                                                <Image Width="16" Height="16" Source="{StaticResource WeightIconScaleSlate}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding CurrentWeight, StringFormat={}{0:F3}}" Foreground="#0F172B" FontSize="24" LineHeight="36" />
                                            <TextBlock Text="g" Foreground="#90A1B9" FontSize="14" Margin="8,12,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="输入微升" Foreground="#62748E" FontSize="14" />
                                            <Border Width="28" Height="28" Background="#F1F5F9" CornerRadius="8" HorizontalAlignment="Right">
                                                <Image Width="16" Height="16" Source="{StaticResource WeightIconTubeSlate}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding InputMicroliter, StringFormat={}{0:F3}}" Foreground="#0F172B" FontSize="24" LineHeight="36" />
                                            <TextBlock Text="ul" Foreground="#90A1B9" FontSize="14" Margin="8,12,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="4" BorderBrush="#BEDBFF" BorderThickness="1" CornerRadius="14" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="重量转微升系数" Foreground="#62748E" FontSize="14" />
                                            <Border Width="28" Height="28" Background="#EAF1FF" CornerRadius="8" HorizontalAlignment="Right">
                                                <Image Width="16" Height="16" Source="{StaticResource WeightIconSigmaSmallBlue}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding MicroliterPerWeight, StringFormat={}{0:F6}}" Foreground="#155DFC" FontSize="24" LineHeight="36" />
                                            <TextBlock Text="ul/g" Foreground="#90A1B9" FontSize="14" Margin="8,12,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Margin="24,0,24,24" Padding="20,16" Style="{StaticResource WeightCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Image Width="16" Height="16" Source="{StaticResource WeightIconSigmaSlate}" Margin="0,0,8,0" />
                    <TextBlock Text="系数配置 · 用于持久化保存当前调试结果" Foreground="#62748E" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding LoadConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Source="{StaticResource WeightIconLoadDark}" Margin="0,0,8,0" />
                            <TextBlock Text="加载 Json" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveConfigCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="110">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Source="{StaticResource WeightIconSaveWhite}" Margin="0,0,8,0" />
                            <TextBlock Text="保存 Json" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
