<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Blood_Alcohol.Views.PointPositionControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Blood_Alcohol.ViewModels"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.DataContext>
        <vm:PointPositionControlViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Geometry x:Key="CoordinateIconGeometry">M4.16667 2.5V15.8333H17.5 M4.16667 15.8333L9.16667 10.8333 M1.66667 5L4.16667 2.5L6.66667 5 M15 13.3333L17.5 15.8333L15 18.3333</Geometry>
        <Geometry x:Key="SearchIconGeometry">M7.33333 12.6667C10.2789 12.6667 12.6667 10.2789 12.6667 7.33333C12.6667 4.38781 10.2789 2 7.33333 2C4.38781 2 2 4.38781 2 7.33333C2 10.2789 4.38781 12.6667 7.33333 12.6667Z M14 14L11.1333 11.1333</Geometry>
        <Geometry x:Key="TargetIconGeometry">M8 14.6667C11.6819 14.6667 14.6667 11.6819 14.6667 8C14.6667 4.3181 11.6819 1.33333 8 1.33333C4.3181 1.33333 1.33333 4.3181 1.33333 8C1.33333 11.6819 4.3181 14.6667 8 14.6667Z M14.6667 8H12 M4 8H1.33333 M8 4V1.33333 M8 14.6667V12</Geometry>
        <Geometry x:Key="HomeIconGeometry">M10 14V8.66667C10 8.48986 9.92976 8.32029 9.80474 8.19526C9.67971 8.07024 9.51014 8 9.33333 8H6.66667C6.48986 8 6.32029 8.07024 6.19526 8.19526C6.07024 8.32029 6 8.48986 6 8.66667V14 M2 6.66667C1.99995 6.47271 2.04222 6.28108 2.12386 6.10514C2.20549 5.92921 2.32453 5.7732 2.47267 5.648L7.13933 1.64867C7.37999 1.44527 7.6849 1.33368 8 1.33368C8.3151 1.33368 8.62001 1.44527 8.86067 1.64867L13.5273 5.648C13.6755 5.7732 13.7945 5.92921 13.8761 6.10514C13.9578 6.28108 14 6.47271 14 6.66667V12.6667C14 13.0203 13.8595 13.3594 13.6095 13.6095C13.3594 13.8595 13.0203 14 12.6667 14H3.33333C2.97971 14 2.64057 13.8595 2.39052 13.6095C2.14048 13.3594 2 13.0203 2 12.6667V6.66667Z</Geometry>
        <Geometry x:Key="WorkIconGeometry">M9.8 4.2C9.67785 4.32462 9.60943 4.49216 9.60943 4.66667C9.60943 4.84117 9.67785 5.00871 9.8 5.13333L10.8667 6.2C10.9913 6.32215 11.1588 6.39057 11.3333 6.39057C11.5078 6.39057 11.6754 6.32215 11.8 6.2L14.3133 3.68667C14.6486 4.42746 14.7501 5.25282 14.6043 6.05276C14.4586 6.8527 14.0725 7.58923 13.4975 8.16419C12.9226 8.73914 12.186 9.12522 11.3861 9.27097C10.5862 9.41672 9.76079 9.31522 9.02 8.98L4.41333 13.5867C4.14812 13.8519 3.78841 14.0009 3.41333 14.0009C3.03826 14.0009 2.67855 13.8519 2.41333 13.5867C2.14812 13.3214 1.99912 12.9617 1.99912 12.5867C1.99912 12.2116 2.14812 11.8519 2.41333 11.5867L7.02 6.98C6.68478 6.23921 6.58328 5.41384 6.72903 4.6139C6.87478 3.81396 7.26086 3.07744 7.83581 2.50248C8.41077 1.92752 9.1473 1.54145 9.94724 1.39569C10.7472 1.24994 11.5725 1.35144 12.3133 1.68667L9.80667 4.19333L9.8 4.2Z</Geometry>
        <Geometry x:Key="PulseIconGeometry">M14.6667 8H13.0133C12.722 7.99938 12.4384 8.0942 12.2061 8.26998C11.9737 8.44575 11.8053 8.6928 11.7267 8.97333L10.16 14.5467C10.1499 14.5813 10.1288 14.6117 10.1 14.6333C10.0712 14.655 10.0361 14.6667 10 14.6667C9.96394 14.6667 9.92885 14.655 9.9 14.6333C9.87115 14.6117 9.8501 14.5813 9.84 14.5467L6.16 1.45333C6.1499 1.41871 6.12885 1.3883 6.1 1.36667C6.07115 1.34503 6.03606 1.33333 6 1.33333C5.96394 1.33333 5.92885 1.34503 5.9 1.36667C5.87115 1.3883 5.8501 1.41871 5.84 1.45333L4.27333 7.02667C4.19498 7.3061 4.02759 7.55234 3.79658 7.72801C3.56556 7.90367 3.28355 7.99917 2.99333 8H1.33333</Geometry>

        <Style x:Key="PageTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
            <Setter Property="Foreground" Value="#1E293B" />
        </Style>

        <Style x:Key="SoftCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      Direction="270"
                                      Opacity="0.08"
                                      ShadowDepth="6"
                                      Color="#64748B" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="BorderBrush" Value="#007AFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="AxisActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AxisActionButtonStyle}">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="BorderBrush" Value="#007AFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44"
                        Height="44"
                        Background="#E8F2FF"
                        CornerRadius="14"
                        Margin="0,0,14,0">
                    <Path Data="{StaticResource CoordinateIconGeometry}"
                          Stroke="#155DFC"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="20"
                          Height="20" />
                </Border>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTextStyle}"
                               Text="原位 / 工位控制"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0F172A" />
                    <TextBlock Style="{StaticResource PageTextStyle}"
                               Text="按 C 编号分组，每组固定 X / Y 两轴，按钮直接切换原位与工位"
                               Margin="0,4,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#7C8798" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,9"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTextStyle}"
                                   Text="{Binding Groups.Count}"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A" />
                        <TextBlock Style="{StaticResource PageTextStyle}"
                                   Text="C组"
                                   FontSize="11"
                                   Foreground="#94A3B8" />
                    </StackPanel>
                </Border>
                <Border Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,9"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTextStyle}"
                                   Text="X/Y"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A" />
                        <TextBlock Style="{StaticResource PageTextStyle}"
                                   Text="轴类型"
                                   FontSize="11"
                                   Foreground="#94A3B8" />
                    </StackPanel>
                </Border>
                <Border Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,9">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTextStyle}"
                                   Text="2"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A" />
                        <TextBlock Style="{StaticResource PageTextStyle}"
                                   Text="动作"
                                   FontSize="11"
                                   Foreground="#94A3B8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="28,0,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="330"
                    Height="40"
                    HorizontalAlignment="Left"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource SearchIconGeometry}"
                          Stroke="#90A1B9"
                          StrokeThickness="1.35"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="16"
                          Height="16"
                          VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Margin="8,0,0,0"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#334155"
                             FontFamily="Segoe UI, Microsoft YaHei"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             Text="搜索编号 / 名称 / 地址"
                             ToolTip="当前版本保留为视觉筛选入口，未接入筛选命令。" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Height="40"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,0"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource TargetIconGeometry}"
                              Stroke="#90A1B9"
                              StrokeThickness="1.35"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Width="16"
                              Height="16"
                              Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource PageTextStyle}"
                                   Text="{Binding Groups.Count, StringFormat=匹配 {0} 组}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Content="全部回原位"
                        IsEnabled="False"
                        ToolTip="ViewModel 暂未提供批量回原位命令，界面暂不触发批量写入。" />
                <Button Style="{StaticResource PrimaryToolbarButtonStyle}"
                        Content="全部去工位"
                        Margin="10,0,0,0"
                        IsEnabled="False"
                        ToolTip="ViewModel 暂未提供批量去工位命令，界面暂不触发批量写入。" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Margin="28,0,28,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SoftCardStyle}"
                                Width="248"
                                MinHeight="158"
                                Padding="14"
                                Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="{Binding GroupTitle}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A" />
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="原位 / 工位点"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#94A3B8" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right"
                                            Background="#EFF6FF"
                                            CornerRadius="10"
                                            Padding="9,4"
                                            VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="可控制"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2563EB" />
                                    </Border>
                                </DockPanel>

                                <StackPanel Grid.Row="1">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding XAxis}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28"
                                                Height="28"
                                                Background="#EAF2FF"
                                                CornerRadius="8"
                                                VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource PageTextStyle}"
                                                       Text="{Binding XAxis.AxisText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="#007AFF" />
                                        </Border>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource AxisActionButtonStyle}"
                                                Command="{Binding XAxis.GoHomeCommand}"
                                                Margin="4,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource HomeIconGeometry}"
                                                      Stroke="#314158"
                                                      StrokeThickness="1.35"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="0,0,6,0" />
                                                <StackPanel>
                                                    <TextBlock Text="原位" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding XAxis.HomeAddress}"
                                                               HorizontalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="#94A3B8" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource WorkActionButtonStyle}"
                                                Command="{Binding XAxis.GoWorkCommand}"
                                                Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource WorkIconGeometry}"
                                                      Stroke="#FFFFFF"
                                                      StrokeThickness="1.35"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="0,0,6,0" />
                                                <StackPanel>
                                                    <TextBlock Text="工位" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding XAxis.WorkAddress}"
                                                               HorizontalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="#DCEBFF" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding YAxis}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28"
                                                Height="28"
                                                Background="#EAF2FF"
                                                CornerRadius="8"
                                                VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource PageTextStyle}"
                                                       Text="{Binding YAxis.AxisText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="#007AFF" />
                                        </Border>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource AxisActionButtonStyle}"
                                                Command="{Binding YAxis.GoHomeCommand}"
                                                Margin="4,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource HomeIconGeometry}"
                                                      Stroke="#314158"
                                                      StrokeThickness="1.35"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="0,0,6,0" />
                                                <StackPanel>
                                                    <TextBlock Text="原位" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding YAxis.HomeAddress}"
                                                               HorizontalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="#94A3B8" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource WorkActionButtonStyle}"
                                                Command="{Binding YAxis.GoWorkCommand}"
                                                Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource WorkIconGeometry}"
                                                      Stroke="#FFFFFF"
                                                      StrokeThickness="1.35"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="0,0,6,0" />
                                                <StackPanel>
                                                    <TextBlock Text="工位" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding YAxis.WorkAddress}"
                                                               HorizontalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="#DCEBFF" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                Margin="28,0,28,22"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,12">
            <DockPanel LastChildFill="True">
                <Path Data="{StaticResource PulseIconGeometry}"
                      Stroke="#2B7FFF"
                      StrokeThickness="1.35"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Width="16"
                      Height="16"
                      Margin="0,0,10,0"
                      DockPanel.Dock="Left" />
                <TextBlock Style="{StaticResource PageTextStyle}"
                           Text="{Binding StatusMessage}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
