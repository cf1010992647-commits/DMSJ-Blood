<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Blood_Alcohol.Views.CoordinateDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Blood_Alcohol.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1450"
             FontFamily="Segoe UI, Microsoft YaHei"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.DataContext>
        <vm:CoordinateDebugViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <DropShadowEffect x:Key="CoordinateCardShadow"
                          BlurRadius="10"
                          Direction="270"
                          ShadowDepth="1"
                          Color="#000000"
                          Opacity="0.10" />

        <DrawingImage x:Key="CoordinateIconTargetBlue">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M10 18.3333C14.6024 18.3333 18.3333 14.6024 18.3333 10C18.3333 5.39763 14.6024 1.66667 10 1.66667C5.39763 1.66667 1.66667 5.39763 1.66667 10C1.66667 14.6024 5.39763 18.3333 10 18.3333Z M18.3333 10H15 M5 10H1.66667 M10 5V1.66667 M10 18.3333V15">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#155DFC" Thickness="1.66667" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="CoordinateIconLoadDark">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M14 10V12.6667C14 13.0203 13.8595 13.3594 13.6095 13.6095C13.3594 13.8595 13.0203 14 12.6667 14H3.33333C2.97971 14 2.64057 13.8595 2.39052 13.6095C2.14048 13.3594 2 13.0203 2 12.6667V10 M11.3333 5.33333L8 2L4.66667 5.33333 M8 2V10">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#0A0A0A" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="CoordinateIconSaveWhite">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M10.1333 2C10.485 2.00501 10.8205 2.14878 11.0667 2.4L13.6 4.93333C13.8512 5.17951 13.995 5.51497 14 5.86667V12.6667C14 13.0203 13.8595 13.3594 13.6095 13.6095C13.3594 13.8595 13.0203 14 12.6667 14H3.33333C2.97971 14 2.64057 13.8595 2.39052 13.6095C2.14048 13.3594 2 13.0203 2 12.6667V3.33333C2 2.97971 2.14048 2.64057 2.39052 2.39052C2.64057 2.14048 2.97971 2 3.33333 2H10.1333Z M11.3333 14V9.33333C11.3333 9.15652 11.2631 8.98695 11.1381 8.86193C11.013 8.73691 10.8435 8.66667 10.6667 8.66667H5.33333C5.15652 8.66667 4.98695 8.73691 4.86193 8.86193C4.7369 8.98695 4.66667 9.15652 4.66667 9.33333V14 M4.66667 2V4.66667C4.66667 4.84348 4.7369 5.01305 4.86193 5.13807C4.98695 5.2631 5.15652 5.33333 5.33333 5.33333H10">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="CoordinateIconPulseBlue">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M14.6667 8H13.0133C12.722 7.99938 12.4384 8.0942 12.2061 8.26998C11.9737 8.44575 11.8053 8.6928 11.7267 8.97333L10.16 14.5467C10.1499 14.5813 10.1288 14.6117 10.1 14.6333C10.0712 14.655 10.0361 14.6667 10 14.6667C9.96394 14.6667 9.92885 14.655 9.9 14.6333C9.87115 14.6117 9.8501 14.5813 9.84 14.5467L6.16 1.45333C6.1499 1.41871 6.12885 1.3883 6.1 1.36667C6.07115 1.34503 6.03606 1.33333 6 1.33333C5.96394 1.33333 5.92885 1.34503 5.9 1.36667C5.87115 1.3883 5.8501 1.41871 5.84 1.45333L4.27333 7.02667C4.19498 7.3061 4.02759 7.55234 3.79658 7.72801C3.56556 7.90367 3.28355 7.99917 2.99333 8H1.33333">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2B7FFF" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="CoordinateIconTubeWhite">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M9.66667 1.33333V13C9.66667 13.9333 8.93333 14.6667 8 14.6667C7.06667 14.6667 6.33333 13.9333 6.33333 13V1.33333 M5.66667 1.33333H10.3333 M9.66667 10.6667H6.33333">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="CoordinateIconGridBlue">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M2.66667 2.66667H6.66667V6.66667H2.66667V2.66667Z M9.33333 2.66667H13.3333V6.66667H9.33333V2.66667Z M2.66667 9.33333H6.66667V13.3333H2.66667V9.33333Z M9.33333 9.33333H13.3333V13.3333H9.33333V9.33333Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#155DFC" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="CoordinateIconPinBlue">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M8 8.66667C9.10457 8.66667 10 7.77124 10 6.66667C10 5.5621 9.10457 4.66667 8 4.66667C6.89543 4.66667 6 5.5621 6 6.66667C6 7.77124 6.89543 8.66667 8 8.66667Z M8 14.6667C10.6667 12 13.3333 9.61219 13.3333 6.66667C13.3333 3.72115 10.9455 1.33333 8 1.33333C5.05448 1.33333 2.66667 3.72115 2.66667 6.66667C2.66667 9.61219 5.33333 12 8 14.6667Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#155DFC" Thickness="1.33333" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style x:Key="CoordinateCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect" Value="{StaticResource CoordinateCardShadow}" />
        </Style>

        <Style x:Key="CoordinateTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#0F172B" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#155DFC"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1" />
                                <Setter Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoordinateButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#155DFC" />
            <Setter Property="BorderBrush" Value="#155DFC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CoordinateButtonStyle}">
            <Setter Property="Foreground" Value="#0A0A0A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172B" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineHeight" Value="24" />
        </Style>

        <Style x:Key="SectionSubTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#62748E" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#62748E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#62748E" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#314158" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoordinateTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="4" HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="0,24,0,0" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoordinateTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#0A0A0A" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Height="{TemplateBinding Height}"
                                MinWidth="{TemplateBinding MinWidth}"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="14">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#155DFC" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FieldTemplate">
            <StackPanel />
        </DataTemplate>

        <DataTemplate x:Key="ProfileTemplate" DataType="{x:Type vm:CoordinateProfileViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CoordinateCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" Background="#EAF1FF" CornerRadius="10" Margin="0,0,12,0">
                                            <Image Width="16" Height="16" Source="{StaticResource CoordinateIconGridBlue}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="点阵参数" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="行列 / 地址 / 步距" Style="{StaticResource SectionSubTitleStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="9,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalPoints, StringFormat={}{0} 点}" Foreground="#45556C" FontSize="12" FontWeight="Medium" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Expander Header="点阵规模与寄存器" IsExpanded="True" Margin="16,16,16,0" Foreground="#314158">
                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,8,12">
                                        <TextBlock Text="行数" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Rows}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,12">
                                        <TextBlock Text="列数" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Columns}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,12">
                                        <TextBlock Text="X起始D地址" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding XStartAddress}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,12">
                                        <TextBlock Text="Y起始D地址" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding YStartAddress}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="步长寄存器数" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding RegisterStridePerPoint}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="比例(兼容)" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Scale, StringFormat=F0}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Expander>

                            <Expander Header="坐标与步距" IsExpanded="True" Margin="16,16,16,0" Foreground="#314158">
                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,8,12">
                                        <TextBlock Text="当前X地址" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding CurrentXAddress}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,12">
                                        <TextBlock Text="当前Y地址" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding CurrentYAddress}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,12">
                                        <TextBlock Text="起点X坐标" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding BaseX, StringFormat=F0}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,12">
                                        <TextBlock Text="起点Y坐标" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding BaseY, StringFormat=F0}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="X步距" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding StepX, StringFormat=F0}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Y步距" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding StepY, StringFormat=F0}" Style="{StaticResource CoordinateTextBoxStyle}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Expander>

                            <Expander Header="两点推导操作" IsExpanded="False" Margin="16,16,16,0" Foreground="#314158">
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="采集第一点P1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CaptureFirstCornerCommand}" Margin="0,0,8,8" MinWidth="118" />
                                    <Button Content="采集X2Y2并推导" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CaptureLastCornerAndGenerateCommand}" Margin="0,0,8,8" MinWidth="140" />
                                    <Button Content="两点重新推导" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GenerateFromTwoCornersCommand}" Margin="0,0,8,8" MinWidth="118" />
                                </WrapPanel>
                            </Expander>

                            <WrapPanel Margin="16,16,16,16">
                                <Button Content="重建点位" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BuildGridCommand}" Margin="0,0,8,8" />
                                <Button Content="从起点推导" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GenerateFromBaseCommand}" Margin="0,0,8,8" />
                                <Button Content="读当前到起点" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ReadCurrentToBaseCommand}" Margin="0,0,8,8" MinWidth="118" />
                                <Button Content="读取PLC点表" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ReadPointsFromPlcCommand}" Margin="0,0,8,8" MinWidth="118" />
                                <Button Content="写入全部点" Style="{StaticResource CoordinateButtonStyle}" Command="{Binding WriteAllPointsToPlcCommand}" Margin="0,0,8,8" />
                                <Button Content="写入选中点" Style="{StaticResource CoordinateButtonStyle}" Command="{Binding WriteSelectedPointToPlcCommand}" Margin="0,0,8,8" />
                                <Button Content="选中点设为起点" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetBaseFromSelectedPointCommand}" Margin="0,0,8,8" MinWidth="126" />
                                <Button Content="采集当前到选中点" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CaptureLiveToSelectedPointCommand}" Margin="0,0,8,8" MinWidth="140" />
                                <Button Content="采集并写入选中点" Style="{StaticResource CoordinateButtonStyle}" Command="{Binding CaptureLiveAndWriteSelectedPointCommand}" Margin="0,0,8,8" MinWidth="140" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CoordinateCardStyle}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" Background="#EAF1FF" CornerRadius="10" Margin="0,0,12,0">
                                        <Image Width="16" Height="16" Source="{StaticResource CoordinateIconPinBlue}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="点位列表" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="点击行选中，可单独写入" Style="{StaticResource SectionSubTitleStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalPoints, StringFormat={}{0}/{0}}" Foreground="#45556C" FontSize="12" FontWeight="Medium" />
                                </Border>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Points}"
                                  SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                                  Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="点号" Binding="{Binding Index}" Width="64" IsReadOnly="True" />
                                <DataGridTextColumn Header="行" Binding="{Binding Row}" Width="56" IsReadOnly="True" />
                                <DataGridTextColumn Header="列" Binding="{Binding Column}" Width="56" IsReadOnly="True" />
                                <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="X地址" Binding="{Binding XAddress}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Y地址" Binding="{Binding YAddress}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="X (×0.01mm)" Binding="{Binding X, StringFormat=F0, UpdateSourceTrigger=PropertyChanged}" Width="112" />
                                <DataGridTextColumn Header="Y (×0.01mm)" Binding="{Binding Y, StringFormat=F0, UpdateSourceTrigger=PropertyChanged}" Width="112" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="16,10">
                            <TextBlock Text="{Binding ProfileStatusMessage}" Foreground="#62748E" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ZProfileTemplate" DataType="{x:Type vm:ZCoordinateProfileViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CoordinateCardStyle}">
                    <StackPanel>
                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" Background="#EAF1FF" CornerRadius="10" Margin="0,0,12,0">
                                    <Image Width="16" Height="16" Source="{StaticResource CoordinateIconTargetBlue}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Z轴参数" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="点数 / 地址 / 起点" Style="{StaticResource SectionSubTitleStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="16,16,16,0">
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="点位总数" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding PointCount}" Style="{StaticResource CoordinateTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="Z起始D地址" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding ZStartAddress}" Style="{StaticResource CoordinateTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="步长寄存器数" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding RegisterStridePerPoint}" Style="{StaticResource CoordinateTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="当前Z地址" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding CurrentZAddress}" Style="{StaticResource CoordinateTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="起点Z坐标" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding BaseZ, StringFormat=F0}" Style="{StaticResource CoordinateTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="比例(兼容)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Scale, StringFormat=F0}" Style="{StaticResource CoordinateTextBoxStyle}" />
                            </StackPanel>
                        </UniformGrid>

                        <WrapPanel Margin="16,8,16,16">
                            <Button Content="重建点位" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BuildGridCommand}" Margin="0,0,8,8" />
                            <Button Content="读当前到起点" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ReadCurrentToBaseCommand}" Margin="0,0,8,8" MinWidth="118" />
                            <Button Content="读取PLC点表" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ReadPointsFromPlcCommand}" Margin="0,0,8,8" MinWidth="118" />
                            <Button Content="写入全部点" Style="{StaticResource CoordinateButtonStyle}" Command="{Binding WriteAllPointsToPlcCommand}" Margin="0,0,8,8" />
                            <Button Content="写入选中点" Style="{StaticResource CoordinateButtonStyle}" Command="{Binding WriteSelectedPointToPlcCommand}" Margin="0,0,8,8" />
                            <Button Content="选中点设为起点" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SetBaseFromSelectedPointCommand}" Margin="0,0,8,8" MinWidth="126" />
                            <Button Content="采集当前到选中点" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CaptureLiveToSelectedPointCommand}" Margin="0,0,8,8" MinWidth="140" />
                            <Button Content="采集并写入选中点" Style="{StaticResource CoordinateButtonStyle}" Command="{Binding CaptureLiveAndWriteSelectedPointCommand}" Margin="0,0,8,8" MinWidth="140" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CoordinateCardStyle}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" Background="#EAF1FF" CornerRadius="10" Margin="0,0,12,0">
                                        <Image Width="16" Height="16" Source="{StaticResource CoordinateIconPinBlue}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Z点位列表" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="点击行选中，可单独写入" Style="{StaticResource SectionSubTitleStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalPoints, StringFormat={}{0}/{0}}" Foreground="#45556C" FontSize="12" FontWeight="Medium" />
                                </Border>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Points}"
                                  SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                                  Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="点号" Binding="{Binding Index}" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Z地址" Binding="{Binding ZAddress}" Width="130" IsReadOnly="True" />
                                <DataGridTextColumn Header="Z坐标" Binding="{Binding Z, StringFormat=F0, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="16,10">
                            <TextBlock Text="{Binding ProfileStatusMessage}" Foreground="#62748E" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="24,24,24,0" Padding="24,20" Style="{StaticResource CoordinateCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="#EAF1FF" CornerRadius="10" Margin="0,0,12,0">
                            <Image Width="20" Height="20" Source="{StaticResource CoordinateIconTargetBlue}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="坐标调试" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="采血管 / 顶空瓶 / 其他位 / 枪头 / Z 轴 点表配置" Style="{StaticResource SectionSubTitleStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ReloadConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="106" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Source="{StaticResource CoordinateIconLoadDark}" Margin="0,0,8,0" />
                                <TextBlock Text="加载配置" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveConfigCommand}" Style="{StaticResource CoordinateButtonStyle}" MinWidth="104">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Source="{StaticResource CoordinateIconSaveWhite}" Margin="0,0,8,0" />
                                <TextBlock Text="保存配置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" Background="#155DFC" CornerRadius="10" Margin="0,0,16,0">
                                <TextBlock Text="X" Foreground="#FFFFFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding RealTimeX}" Foreground="#0F172B" FontSize="22" />
                                <TextBlock Text="{Binding RealTimeXRaw}" Foreground="#90A1B9" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" Background="#00BC7D" CornerRadius="10" Margin="0,0,16,0">
                                <TextBlock Text="Y" Foreground="#FFFFFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding RealTimeY}" Foreground="#0F172B" FontSize="22" />
                                <TextBlock Text="{Binding RealTimeYRaw}" Foreground="#90A1B9" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" Background="#FE9A00" CornerRadius="10" Margin="0,0,16,0">
                                <TextBlock Text="Z" Foreground="#FFFFFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding RealTimeZ}" Foreground="#0F172B" FontSize="22" />
                                <TextBlock Text="{Binding RealTimeZRaw}" Foreground="#90A1B9" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#00BC7D" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding RealTimeStatus}" Foreground="#45556C" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,12,24,0" Padding="20,12" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="14">
            <StackPanel Orientation="Horizontal">
                <Image Width="16" Height="16" Source="{StaticResource CoordinateIconPulseBlue}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#314158" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2"
                    Margin="24,16,24,24"
                    Style="{StaticResource CoordinateTabControlStyle}"
                    ItemContainerStyle="{StaticResource CoordinateTabItemStyle}">
            <TabItem Header="采血管 XY">
                <ContentControl Content="{Binding BloodTubeProfile}" ContentTemplate="{StaticResource ProfileTemplate}" />
            </TabItem>
            <TabItem Header="顶空瓶 XY">
                <ContentControl Content="{Binding HeadspaceVialProfile}" ContentTemplate="{StaticResource ProfileTemplate}" />
            </TabItem>
            <TabItem Header="其他 XY">
                <ContentControl Content="{Binding OtherPositionProfile}" ContentTemplate="{StaticResource ProfileTemplate}" />
            </TabItem>
            <TabItem Header="枪头 XY">
                <ContentControl Content="{Binding PipetteTipProfile}" ContentTemplate="{StaticResource ProfileTemplate}" />
            </TabItem>
            <TabItem Header="Z 轴">
                <ContentControl Content="{Binding ZAxisProfile}" ContentTemplate="{StaticResource ZProfileTemplate}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
