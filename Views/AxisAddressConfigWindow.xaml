<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Blood_Alcohol.Views.AxisAddressConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Blood_Alcohol.ViewModels"
        Title="{Binding SelectedAxisTitle}"
        Width="1320"
        Height="820"
        MinWidth="1024"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Inter, Segoe UI, Microsoft YaHei"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.DataContext>
        <vm:AxisAddressConfigViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="WeakBorderBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#155DFC" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172B" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#62748E" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#90A1B9" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#00BC7D" />

