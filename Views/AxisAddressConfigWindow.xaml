        <Geometry x:Key="CloseIconGeometry">M12 4L4 12 M4 4L12 12</Geometry>
        <Geometry x:Key="OverviewIconGeometry">M8 14.6667C11.6819 14.6667 14.6667 11.6819 14.6667 8C14.6667 4.3181 11.6819 1.33333 8 1.33333C4.3181 1.33333 1.33333 4.3181 1.33333 8C1.33333 11.6819 4.3181 14.6667 8 14.6667Z M14.6667 8H12 M4 8H1.33333 M8 4V1.33333 M8 14.6667V12</Geometry>
        <Geometry x:Key="CoilIconGeometry">M2.66667 9.33333C2.54051 9.33376 2.41682 9.29839 2.30997 9.23132C2.20312 9.16425 2.11749 9.06824 2.06303 8.95444C2.00858 8.84064 1.98753 8.71372 2.00233 8.58844C2.01714 8.46315 2.06719 8.34464 2.14667 8.24667L8.74667 1.44667C8.79617 1.38952 8.86364 1.3509 8.93799 1.33715C9.01234 1.32341 9.08915 1.33534 9.15582 1.371C9.22249 1.40666 9.27506 1.46393 9.30489 1.53341C9.33472 1.60288 9.34005 1.68043 9.32 1.75333L8.04 5.76667C8.00226 5.86768 7.98958 5.97635 8.00306 6.08334C8.01654 6.19033 8.05577 6.29245 8.11739 6.38095C8.17901 6.46945 8.26118 6.54168 8.35685 6.59144C8.45252 6.6412 8.55883 6.66702 8.66667 6.66667H13.3333C13.4595 6.66624 13.5832 6.70161 13.69 6.76868C13.7969 6.83575 13.8825 6.93176 13.937 7.04556C13.9914 7.15936 14.0125 7.28628 13.9977 7.41156C13.9829 7.53685 13.9328 7.65536 13.8533 7.75333L7.25333 14.5533C7.20383 14.6105 7.13636 14.6491 7.06201 14.6628C6.98766 14.6766 6.91085 14.6647 6.84418 14.629C6.77751 14.5933 6.72494 14.5361 6.69511 14.4666C6.66528 14.3971 6.65995 14.3196 6.68 14.2467L7.96 10.2333C7.99774 10.1323 8.01042 10.0237 7.99694 9.91666C7.98346 9.80967 7.94423 9.70755 7.88261 9.61905C7.82099 9.53055 7.73882 9.45832 7.64315 9.40856C7.54748 9.3588 7.44117 9.33298 7.33333 9.33333H2.66667Z</Geometry>
        <Geometry x:Key="RegisterIconGeometry">M12 2.66667H4C3.26362 2.66667 2.66667 3.26362 2.66667 4V12C2.66667 12.7364 3.26362 13.3333 4 13.3333H12C12.7364 13.3333 13.3333 12.7364 13.3333 12V4C13.3333 3.26362 12.7364 2.66667 12 2.66667Z M9.33333 6H6.66667C6.29848 6 6 6.29848 6 6.66667V9.33333C6 9.70152 6.29848 10 6.66667 10H9.33333C9.70152 10 10 9.70152 10 9.33333V6.66667C10 6.29848 9.70152 6 9.33333 6Z M10 1.33333V2.66667 M10 13.3333V14.6667 M1.33333 10H2.66667 M1.33333 6H2.66667 M13.3333 10H14.6667 M13.3333 6H14.6667 M6 1.33333V2.66667 M6 13.3333V14.6667</Geometry>
        <Geometry x:Key="PreviewIconGeometry">M2.66667 6H13.3333 M2.66667 10H13.3333 M6.66667 2L5.33333 14 M10.6667 2L9.33333 14</Geometry>
        <Geometry x:Key="StatusIconGeometry">M14.6667 8H13.0133C12.722 7.99938 12.4384 8.0942 12.2061 8.26998C11.9737 8.44575 11.8053 8.6928 11.7267 8.97333L10.16 14.5467C10.1499 14.5813 10.1288 14.6117 10.1 14.6333C10.0712 14.655 10.0361 14.6667 10 14.6667C9.96394 14.6667 9.92885 14.655 9.9 14.6333C9.87115 14.6117 9.8501 14.5813 9.84 14.5467L6.16 1.45333C6.1499 1.41871 6.12885 1.3883 6.1 1.36667C6.07115 1.34503 6.03606 1.33333 6 1.33333C5.96394 1.33333 5.92885 1.34503 5.9 1.36667C5.87115 1.3883 5.8501 1.41871 5.84 1.45333L4.27333 7.02667C4.19498 7.3061 4.02759 7.55234 3.79658 7.72801C3.56556 7.90367 3.28355 7.99917 2.99333 8H1.33333</Geometry>

        <DropShadowEffect x:Key="CardShadowEffect"
                          BlurRadius="10"
                          Direction="270"
                          ShadowDepth="2"
                          Opacity="0.10"
                          Color="#000000" />

        <Style x:Key="PageTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTextStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0A0A0A" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#BFDBFE" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="InputBorder" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0A0A0A" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="AxisTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TabStripPlacement" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True"
                                  Background="Transparent"
                                  KeyboardNavigation.TabIndex="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AxisTabItemStyle" TargetType="TabItem">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Height="58"
                                Padding="10,8"
                                Background="Transparent"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AxisBadge"
                                        Width="36"
                                        Height="36"
                                        Background="#F1F5F9"
                                        CornerRadius="10">
                                    <TextBlock x:Name="AxisShortText"
                                               Style="{StaticResource PageTextStyle}"
                                               Text="{Binding AxisShortName}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#45556C" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="AxisNameText"
                                               Style="{StaticResource PageTextStyle}"
                                               Text="{Binding AxisName}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="AxisStateText"
                                               Style="{StaticResource PageTextStyle}"
                                               Text="{Binding AxisDisplayName}"
                                               Margin="0,2,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="AxisBadge" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="AxisShortText" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="AxisNameText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="AxisStateText" Property="Text" Value="当前编辑" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="24,24,0,24"
                Background="#FFFFFF"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="75" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="86" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource WeakBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,16,16,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTextStyle}"
                                   Text="轴选择"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource PageTextStyle}"
                                   Text="{Binding Axes.Count, StringFormat=共 {0} 条轴}"
                                   Margin="0,4,0,0"
                                   FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="1"
                            Margin="8,8,8,0"
                            ItemsSource="{Binding Axes}"
                            SelectedItem="{Binding SelectedAxis, Mode=TwoWay}"
                            ItemContainerStyle="{StaticResource AxisTabItemStyle}"
                            Style="{StaticResource AxisTabControlStyle}" />

                <Border Grid.Row="2"
                        Margin="12,0,12,12"
                        Padding="12"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        VerticalAlignment="Bottom">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource SuccessBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource PageTextStyle}"
                                       Text="地址配置"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Style="{StaticResource PageTextStyle}"
                                       Text="单轴编辑，保存后生效"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="16,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}"
                    Padding="20"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40"
                                Height="40"
                                Background="#EAF2FF"
                                CornerRadius="10"
                                Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource PageTextStyle}"
                                       Text="{Binding SelectedAxis.AxisShortName}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTextStyle}"
                                       Text="{Binding SelectedAxis.AxisConfigTitle}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Style="{StaticResource PageTextStyle}"
                                       Text="维护轴调试相关 M / D 地址"
                                       Margin="0,2,0,0"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource HeaderButtonStyle}"
                                Command="{Binding ReloadCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ReloadIconGeometry}"
                                      Stroke="#0A0A0A"
                                      StrokeThickness="1.35"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="重新加载" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HeaderButtonStyle}"
                                Command="{Binding ResetDefaultCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ResetIconGeometry}"
                                      Stroke="#0A0A0A"
                                      StrokeThickness="1.35"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="恢复默认" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryHeaderButtonStyle}"
                                Command="{Binding SaveCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource SaveIconGeometry}"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.35"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="保存配置" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HeaderButtonStyle}"
                                MinWidth="76"
                                Click="CloseButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CloseIconGeometry}"
                                      Stroke="#0A0A0A"
                                      StrokeThickness="1.35"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="关闭" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          DataContext="{Binding SelectedAxis}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource CardStyle}"
                            Padding="0"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource WeakBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="20,16">
                                <DockPanel LastChildFill="True">
                                    <Border Width="36"
                                            Height="36"
                                            Background="#EAF2FF"
                                            CornerRadius="10"
                                            DockPanel.Dock="Left"
                                            Margin="0,0,12,0">
                                        <Path Data="{StaticResource OverviewIconGeometry}"
                                              Stroke="{StaticResource AccentBrush}"
                                              StrokeThickness="1.35"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"
                                              Width="16"
                                              Height="16" />
                                    </Border>
                                    <Border DockPanel.Dock="Right"
                                            Background="#DCFCE7"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5"
                                                     Height="5"
                                                     Fill="{StaticResource SuccessBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                                            <TextBlock Style="{StaticResource PageTextStyle}"
                                                       Text="已同步"
                                                       FontSize="12"
                                                       Foreground="#008236" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="当前轴概览"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Grid Margin="20,18,20,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="60"
                                        Height="60"
                                        Background="#EAF2FF"
                                        CornerRadius="14"
                                        VerticalAlignment="Bottom">
                                    <TextBlock Style="{StaticResource PageTextStyle}"
                                               Text="{Binding AxisShortName}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="轴名称" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding AxisName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="轴编号" />
                                    <Border Height="34"
                                            Padding="12,0"
                                            Background="{StaticResource FieldBackgroundBrush}"
                                            CornerRadius="8">
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="{Binding AxisDisplayName}"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="#0A0A0A" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource CardStyle}"
                                Padding="0">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource WeakBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="20,16">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="36"
                                                Height="36"
                                                Background="#EAF2FF"
                                                CornerRadius="10"
                                                DockPanel.Dock="Left"
                                                Margin="0,0,12,0">
                                            <Path Data="{StaticResource CoilIconGeometry}"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"
                                                  Width="16"
                                                  Height="16" />
                                        </Border>
                                        <Border DockPanel.Dock="Right"
                                                Background="#F1F5F9"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource PageTextStyle}"
                                                       Text="8 项"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PageTextStyle}"
                                                       Text="线圈地址 (M)"
                                                       FontSize="16"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Style="{StaticResource PageTextStyle}"
                                                       Text="执行与状态触发点位"
                                                       Margin="0,2,0,0"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <UniformGrid Columns="3" Margin="20,16,20,20">
                                    <StackPanel Margin="0,0,12,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="JOG 正转" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding JogPlusCoil, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="JOG 反转" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding JogMinusCoil, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="回原点触发" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding GoHomeCoil, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="回原点完成" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding HomeDoneCoil, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="正限位" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding PositiveLimitCoil, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="负限位" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NegativeLimitCoil, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="原点传感器" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding HomeSensorCoil, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="手动定位触发" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding ManualLocateTriggerCoil, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource CardStyle}"
                                Padding="0">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource WeakBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="20,16">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="36"
                                                Height="36"
                                                Background="#EAF2FF"
                                                CornerRadius="10"
                                                DockPanel.Dock="Left"
                                                Margin="0,0,12,0">
                                            <Path Data="{StaticResource RegisterIconGeometry}"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"
                                                  Width="16"
                                                  Height="16" />
                                        </Border>
                                        <Border DockPanel.Dock="Right"
                                                Background="#F1F5F9"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource PageTextStyle}"
                                                       Text="10 项"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PageTextStyle}"
                                                       Text="寄存器地址 (D)"
                                                       FontSize="16"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Style="{StaticResource PageTextStyle}"
                                                       Text="位置、速度与时间寄存器映射"
                                                       Margin="0,2,0,0"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <UniformGrid Columns="3" Margin="20,16,20,20">
                                    <StackPanel Margin="0,0,12,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="当前位置低位" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding CurrentPositionLowRegister, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="当前位置高位" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding CurrentPositionHighRegister, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="手动速度低位" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding ManualSpeedRegister, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="手动速度高位" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding ManualSpeedHighRegister, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="自动速度低位" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding AutoSpeedRegister, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="自动速度高位" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding AutoSpeedHighRegister, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="手动目标低位" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding ManualTargetLowRegister, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="手动目标高位" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding ManualTargetHighRegister, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="加速时间" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding AccelerationTimeRegister, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="减速时间" />
                                        <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding DecelerationTimeRegister, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Style="{StaticResource CardStyle}"
                            Padding="0"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource WeakBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="20,16">
                                <DockPanel LastChildFill="True">
                                    <Border Width="36"
                                            Height="36"
                                            Background="#EAF2FF"
                                            CornerRadius="10"
                                            DockPanel.Dock="Left"
                                            Margin="0,0,12,0">
                                        <Path Data="{StaticResource PreviewIconGeometry}"
                                              Stroke="{StaticResource AccentBrush}"
                                              StrokeThickness="1.35"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"
                                              Width="16"
                                              Height="16" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="地址预览"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="保存前快速确认关键地址段是否连续"
                                                   Margin="0,2,0,0"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <UniformGrid Columns="3" Margin="20,16,20,20">
                                <Border Height="66"
                                        Margin="0,0,12,0"
                                        Padding="13,10"
                                        Background="#F8FAFC"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="运动控制 (M)"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="{Binding CoilRangeText}"
                                                   Margin="0,4,0,0"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Height="66"
                                        Margin="0,0,12,0"
                                        Padding="13,10"
                                        Background="#F8FAFC"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="速度参数 (D)"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="{Binding SpeedRegisterRangeText}"
                                                   Margin="0,4,0,0"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Height="66"
                                        Padding="13,10"
                                        Background="#F8FAFC"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="定位参数 (D)"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Style="{StaticResource PageTextStyle}"
                                                   Text="{Binding LocateRegisterRangeText}"
                                                   Margin="0,4,0,0"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Height="46"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20,0"
                    Effect="{StaticResource CardShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource StatusIconGeometry}"
                          Stroke="#2B7FFF"
                          StrokeThickness="1.35"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="16"
                          Height="16"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource PageTextStyle}"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#314158"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource PageTextStyle}"
                               Text="固定状态栏"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
