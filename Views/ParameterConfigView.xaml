        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>

        <Style x:Key="SectionHeaderIconBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#EAF1FF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172B" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineHeight" Value="24" />
        </Style>

        <Style x:Key="SubTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#62748E" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="ParamNameStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1D293D" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RegisterHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90A1B9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <Style x:Key="UnitTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#62748E" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#155DFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#155DFC" />
            <Setter Property="BorderBrush" Value="#155DFC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.84" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="#0A0A0A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="104" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
                <Border Style="{StaticResource CardStyle}" Padding="24,20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" Background="#EAF1FF" CornerRadius="10" Margin="0,0,12,0">
                                <Image Width="20" Height="20" Source="{StaticResource FigmaParameterIconSettings}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="参数配置" Style="{StaticResource TitleTextStyle}" />
                                <TextBlock Text="温控设置 / 流体延时 / 运动位置参数" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="参数总数" Style="{StaticResource SubTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="22" Foreground="#0F172B" FontSize="16" Margin="8,0,24,0" VerticalAlignment="Center" />
                            <Ellipse Width="8" Height="8" Fill="#00BC7D" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="已同步" Style="{StaticResource SubTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="14" Padding="20,12" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#2B7FFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#314158" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource SectionHeaderIconBoxStyle}">
                                        <Image Width="16" Height="16" Source="{StaticResource FigmaParameterIconThermometer}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="温控与摇匀参数" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="加热区温度阈值与摇匀时长配置" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock Text="5 项" Foreground="#45556C" FontSize="12" FontWeight="Medium" />
                                </Border>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="2" Margin="32,24,32,24">
                            <Grid Margin="0,0,48,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="加热箱温度" Style="{StaticResource ParamNameStyle}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding HeatingBoxTemperature, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" Style="{StaticResource InputBoxStyle}" />
                                <TextBlock Grid.Column="2" Text="°C" Style="{StaticResource UnitTextStyle}" />
                                <TextBox Grid.Column="3" Text="{Binding HeatingBoxTemperatureStation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                                <TextBlock Grid.Column="4" Text="站号" Style="{StaticResource UnitTextStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="定量环温度" Style="{StaticResource ParamNameStyle}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding QuantitativeLoopTemperature, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" Style="{StaticResource InputBoxStyle}" />
                                <TextBlock Grid.Column="2" Text="°C" Style="{StaticResource UnitTextStyle}" />
                                <TextBox Grid.Column="3" Text="{Binding QuantitativeLoopTemperatureStation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                                <TextBlock Grid.Column="4" Text="站号" Style="{StaticResource UnitTextStyle}" />
                            </Grid>
                            <Grid Margin="0,0,48,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="传输线温度" Style="{StaticResource ParamNameStyle}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding TransferLineTemperature, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" Style="{StaticResource InputBoxStyle}" />
                                <TextBlock Grid.Column="2" Text="°C" Style="{StaticResource UnitTextStyle}" />
                                <TextBox Grid.Column="3" Text="{Binding TransferLineTemperatureStation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                                <TextBlock Grid.Column="4" Text="站号" Style="{StaticResource UnitTextStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="预留温控温度" Style="{StaticResource ParamNameStyle}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding ReservedTemperature, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" Style="{StaticResource InputBoxStyle}" />
                                <TextBlock Grid.Column="2" Text="°C" Style="{StaticResource UnitTextStyle}" />
                                <TextBox Grid.Column="3" Text="{Binding ReservedTemperatureStation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBoxStyle}" />
                                <TextBlock Grid.Column="4" Text="站号" Style="{StaticResource UnitTextStyle}" />
                            </Grid>
                            <Grid Margin="0,0,48,0">
