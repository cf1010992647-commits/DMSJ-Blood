        <Style x:Key="CylinderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect" Value="{StaticResource CylinderCardShadow}" />
        </Style>

        <Style x:Key="CylinderButtonBaseStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CylinderPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CylinderButtonBaseStyle}">
            <Setter Property="Background" Value="#155DFC" />
            <Setter Property="BorderBrush" Value="#155DFC" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="CylinderSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CylinderButtonBaseStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#314158" />
        </Style>

        <Style x:Key="CylinderDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="CylinderColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="#62748E" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="CylinderRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="60" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172B" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="Foreground" Value="#0F172B" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsSelected" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#F8FAFC" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CylinderCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="#0F172B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="24,24,24,0" Padding="24,20" Style="{StaticResource CylinderCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" Margin="0,0,12,0" Background="#EAF1FF" CornerRadius="10">
                        <Image Width="20" Height="20" Source="{StaticResource CylinderIconMain}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="气缸手动控制" Foreground="#0F172B" FontSize="16" LineHeight="24" />
                        <TextBlock Margin="0,2,0,0" Text="原位 / 工位切换 · 实时状态监控" Foreground="#62748E" FontSize="14" LineHeight="20" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#00BC7D" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="就绪" Foreground="#62748E" FontSize="14" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" Fill="#2B7FFF" Margin="24,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="控制点" Foreground="#62748E" FontSize="14" VerticalAlignment="Center" />
                    <Image Width="16" Height="16" Source="{StaticResource CylinderIconGear}" Margin="24,0,8,0" />
                    <TextBlock Text="总计" Foreground="#62748E" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Cylinders.Count}" Foreground="#0F172B" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,12,24,0" Padding="20,12" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="14">
            <StackPanel Orientation="Horizontal">
                <Image Width="16" Height="16" Source="{StaticResource CylinderIconInfo}" Margin="0,0,12,0" />
                <TextBlock Foreground="#314158" FontSize="14" VerticalAlignment="Center">
                    <Run Text="每一行对应一个气缸，左侧按钮控制原位，右侧按钮控制工位。页面显示地址为项目 " />
                    <Run Text="M" Foreground="#0F172B" />
                    <Run Text=" 地址，底层通信自动补齐 " />
                    <Run Text="4096" Foreground="#0F172B" />
                    <Run Text=" 偏移。" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="24,16,24,0" Padding="20,16" Style="{StaticResource CylinderCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="288" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Height="36" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Image Width="16" Height="16" Source="{StaticResource CylinderIconSearch}" Margin="12,0,0,0" HorizontalAlignment="Left" />
                        <TextBox Margin="36,0,12,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#717182"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Text="搜索编号 / 名称 / 地址" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Height="22" Padding="9,2" Background="#F1F5F9" CornerRadius="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Cylinders.Count, StringFormat=匹配 {0} 项}" Foreground="#45556C" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                </Border>

                <Button Grid.Column="4"
                        Style="{StaticResource CylinderSecondaryButtonStyle}"
                        MinWidth="120"
                        IsEnabled="False"
                        ToolTip="当前未启用批量回原位命令，避免误触发全部气缸动作">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="16" Height="16" Source="{StaticResource CylinderIconHomeDark}" Margin="0,0,8,0" />
                        <TextBlock Text="全部回原位" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="24,16,24,0" Style="{StaticResource CylinderCardStyle}" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Cylinders}"
                      Style="{StaticResource CylinderDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource CylinderColumnHeaderStyle}"
                      RowStyle="{StaticResource CylinderRowStyle}"
                      CellStyle="{StaticResource CylinderCellStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="编号" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="44" Height="28" Background="#F1F5F9" CornerRadius="8" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding CylinderCode}" Foreground="#314158" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="气缸名称" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="#0F172B"
                                           FontSize="16"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="状态" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Height="26" Padding="10,0" Background="#ECFDF5" BorderBrush="#D0FAE5" BorderThickness="1" CornerRadius="13" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#00BC7D" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="就绪" Foreground="#007A55" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="原位控制" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding GoHomeCommand}" Style="{StaticResource CylinderPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Source="{StaticResource CylinderIconCheckWhite}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding HomeActionText}" />
                                        <TextBlock Text=" (" Opacity="0.8" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding HomeAddress}" Opacity="0.8" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text=")" Opacity="0.8" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="工位控制" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding GoWorkCommand}" Style="{StaticResource CylinderSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Source="{StaticResource CylinderIconWorkDark}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding WorkActionText}" />
                                        <TextBlock Text=" (" Opacity="0.8" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding WorkAddress}" Opacity="0.8" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text=")" Opacity="0.8" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Margin="24,0,24,24" Padding="20,12" Style="{StaticResource CylinderCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="16" Height="16" Source="{StaticResource CylinderIconPulse}" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#314158" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="2026-04-27" Foreground="#90A1B9" FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
