        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172B" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineHeight" Value="24" />
        </Style>

        <Style x:Key="SubTitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#62748E" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172B" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LineHeight" Value="24" />
        </Style>

        <Style x:Key="ActionButtonBaseStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.50" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Background" Value="#E7000B" />
            <Setter Property="BorderBrush" Value="#E7000B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Background" Value="#155DFC" />
            <Setter Property="BorderBrush" Value="#155DFC" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="DarkButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Background" Value="#0F172B" />
            <Setter Property="BorderBrush" Value="#0F172B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#0A0A0A" />
        </Style>

        <Style x:Key="PillBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,2" />
        </Style>

        <Style x:Key="CompactTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Width" Value="96" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F3F3F5" />
            <Setter Property="BorderBrush" Value="#F3F3F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0A0A0A" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#155DFC" />
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FaultGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="RowHeight" Value="37" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC" />
                        <Setter Property="Foreground" Value="#62748E" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Setter Property="BorderBrush" Value="#F1F5F9" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#0F172B" />
                                <Setter Property="Background" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="#0F172B" />
        </Style>

        <Style x:Key="MutedGridTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
            <Setter Property="Foreground" Value="#62748E" />
        </Style>

        <Style x:Key="AddressGridTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
            <Setter Property="Foreground" Value="#314158" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style x:Key="EditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172B" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="24,24,24,0"
                Padding="24,20"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40"
                            Height="40"
                            Background="#EAF1FF"
                            CornerRadius="10"
                            Margin="0,0,12,0">
                        <Image Width="20" Height="20" Source="{StaticResource FigmaFaultIconSettings}" />
                    </Border>

                    <StackPanel>
                        <TextBlock Text="故障调试" Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Text="报警监控 / 屏蔽管理 / 事件日志 / 配置维护"
                                   Style="{StaticResource SubTitleTextStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Image Width="16" Height="16" Margin="0,0,8,0" Source="{StaticResource FigmaFaultIconActive}" />
                        <TextBlock Text="当前有效"
                                   Foreground="#62748E"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ActiveAlarmCount}"
                                   Foreground="#E7000B"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Image Width="16" Height="16" Margin="0,0,8,0" Source="{StaticResource FigmaFaultIconEyeOffGray}" />
                        <TextBlock Text="屏蔽数"
                                   Foreground="#62748E"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding MaskedAlarmCount}"
                                   Foreground="#314158"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#00BC7D"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="正常监控"
                                   Foreground="#62748E"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Padding="20"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel VerticalAlignment="Center">
                        <Button Command="{Binding ClearHmiFaultCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                MinWidth="142"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Margin="0,0,6,0" Source="{StaticResource FigmaFaultIconEraserWhite}" />
                                <TextBlock Text="清除 HMI 报警" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ClearFaultCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                MinWidth="132"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Margin="0,0,6,0" Source="{StaticResource FigmaFaultIconAlertWhite}" />
                                <TextBlock Text="清除当前报警" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ToggleGlobalShieldCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="132"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Margin="0,0,6,0" Source="{StaticResource FigmaFaultIconShieldWhite}" />
                                <TextBlock Text="{Binding GlobalShieldButtonText}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ToggleSelectedMaskCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="132"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Margin="0,0,6,0" Source="{StaticResource FigmaFaultIconEyeOffWhite}" />
                                <TextBlock Text="{Binding SelectedAlarmMaskButtonText}" />
                            </StackPanel>
                        </Button>

                        <Border Width="1"
                                Height="24"
                                Background="#E2E8F0"
                                Margin="4,6,12,6" />

                        <CheckBox Content="仅显示当前报警"
                                  IsChecked="{Binding ShowActiveOnly}"
                                  Foreground="#314158"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />

                        <Button Command="{Binding ClearEventLogCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="134">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Margin="0,0,6,0" Source="{StaticResource FigmaFaultIconTrashDark}" />
                                <TextBlock Text="清空事件日志" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock Text="全局屏蔽位 (M)"
                                   Foreground="#62748E"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Text="{Binding GlobalShieldAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CompactTextBoxStyle}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Height="1"
                        Background="#F1F5F9" />

                <WrapPanel Grid.Row="2">
                    <Button Command="{Binding AddAlarmPointCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="118"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Margin="0,0,6,0" Source="{StaticResource FigmaFaultIconPlusWhite}" />
                            <TextBlock Text="新增报警点" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteSelectedAlarmCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="106"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Margin="0,0,6,0" Source="{StaticResource FigmaFaultIconTrashDark}" />
                            <TextBlock Text="删除选中" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ReloadConfigCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="134"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Margin="0,0,6,0" Source="{StaticResource FigmaFaultIconReloadDark}" />
                            <TextBlock Text="重新加载配置" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveConfigCommand}"
                            Style="{StaticResource DarkButtonStyle}"
                            MinWidth="104">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Margin="0,0,6,0" Source="{StaticResource FigmaFaultIconSaveWhite}" />
                            <TextBlock Text="保存配置" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="#F1F5F9"
                            BorderThickness="0,0,0,1"
                            Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Margin="0,0,8,0" Source="{StaticResource FigmaFaultIconAlertBlue}" />
                                <TextBlock Text="报警点位列表" Style="{StaticResource SectionTitleTextStyle}" />
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource PillBadgeStyle}">
                                <TextBlock Text="{Binding AlarmPoints.Count, StringFormat=共 {0} 项}"
                                           Foreground="#45556C"
                                           FontSize="12"
                                           FontWeight="Medium" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="20"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            CornerRadius="10"
                            ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding AlarmPointsView}"
                                  SelectedItem="{Binding SelectedAlarm, Mode=TwoWay}"
                                  Style="{StaticResource FaultGridStyle}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="状态" Width="128" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10"
                                                         Height="10"
                                                         Fill="{Binding StateColor}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding StateText}"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
                                                            <Setter Property="Foreground" Value="#009966" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#E7000B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                                                    <Setter Property="Foreground" Value="#62748E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="地址"
                                                    Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource AddressGridTextStyle}"
                                                    EditingElementStyle="{StaticResource EditingTextBoxStyle}"
                                                    Width="96" />
                                <DataGridTextColumn Header="报警内容"
                                                    Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource GridTextStyle}"
                                                    EditingElementStyle="{StaticResource EditingTextBoxStyle}"
                                                    Width="*" />
                                <DataGridTextColumn Header="报警时间"
                                                    Binding="{Binding AlarmTimeText}"
                                                    IsReadOnly="True"
                                                    ElementStyle="{StaticResource MutedGridTextStyle}"
                                                    Width="180" />
                                <DataGridTemplateColumn Header="屏蔽" Width="80" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedGridTextStyle}">
                                                        <Setter Property="Text" Value="否" />
                                                        <Setter Property="Foreground" Value="#CAD5E2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                                                <Setter Property="Text" Value="是" />
                                                                <Setter Property="Foreground" Value="#45556C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="#F1F5F9"
                            BorderThickness="0,0,0,1"
                            Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Margin="0,0,8,0" Source="{StaticResource FigmaFaultIconPulseBlue}" />
                                <TextBlock Text="报警事件记录" Style="{StaticResource SectionTitleTextStyle}" />
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource PillBadgeStyle}">
                                <TextBlock Text="{Binding AlarmEvents.Count, StringFormat={}{0} 条}"
                                           Foreground="#45556C"
                                           FontSize="12"
                                           FontWeight="Medium" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="20"
                            BorderBrush="#F1F5F9"
                            BorderThickness="1"
                            CornerRadius="10"
                            ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding AlarmEvents}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  Background="#FFFFFF"
                                  BorderThickness="0"
                                  RowHeight="39"
                                  ColumnHeaderHeight="40"
                                  FontSize="14"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="Foreground" Value="#62748E" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontWeight" Value="Medium" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EFF6FF" />
                                            <Setter Property="Foreground" Value="#0F172B" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间"
                                                    Binding="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                    ElementStyle="{StaticResource MutedGridTextStyle}"
                                                    Width="1.55*" />
                                <DataGridTextColumn Header="地址"
                                                    Binding="{Binding Address}"
                                                    ElementStyle="{StaticResource AddressGridTextStyle}"
                                                    Width="0.7*" />
                                <DataGridTemplateColumn Header="动作" Width="0.75*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Action}" Value="报警触发">
                                                                <Setter Property="Background" Value="#FEF2F2" />
                                                                <Setter Property="BorderBrush" Value="#FFE2E2" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="报警恢复">
                                                                <Setter Property="Background" Value="#ECFDF5" />
                                                                <Setter Property="BorderBrush" Value="#D0FAE5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="12" Text="{Binding Action}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#45556C" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Action}" Value="报警触发">
                                                                    <Setter Property="Foreground" Value="#E7000B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="报警恢复">
                                                                    <Setter Property="Foreground" Value="#009966" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="内容"
                                                    Binding="{Binding Description}"
                                                    ElementStyle="{StaticResource GridTextStyle}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="24,16,24,24"
                Padding="20,12"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="#00BC7D"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#45556C"
                               FontSize="14"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="2026-04-27"
                           Foreground="#90A1B9"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
