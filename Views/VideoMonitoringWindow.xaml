<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Blood_Alcohol.Views.VideoMonitoringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Blood_Alcohol.ViewModels"
        Title="视频监控"
        Width="1400"
        Height="1060"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.DataContext>
        <vm:VideoMonitoringViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="MonitorInfoBrush" Color="#DDE7F3" />

        <DropShadowEffect x:Key="CardShadowEffect"
                          BlurRadius="18"
                          Direction="270"
                          ShadowDepth="3"
                          Opacity="0.10"
                          Color="#000000" />

        <RadialGradientBrush x:Key="MonitorBackgroundBrush"
                             Center="0.5,0.45"
                             GradientOrigin="0.5,0.45"
                             RadiusX="0.8"
                             RadiusY="0.8">
            <GradientStop Color="#334155" Offset="0" />
            <GradientStop Color="#1E293B" Offset="0.45" />
            <GradientStop Color="#0F172A" Offset="1" />
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="MonitorTopMaskBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#80000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MonitorBottomMaskBrush" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#99000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>

        <Geometry x:Key="CameraPlaceholderOuterGeometry">M58 16H38L28 28H16C13.8783 28 11.8434 28.8429 10.3431 30.3431C8.84285 31.8434 8 33.8783 8 36V72C8 74.1217 8.84285 76.1566 10.3431 77.6569C11.8434 79.1571 13.8783 80 16 80H80C82.1217 80 84.1566 79.1571 85.6569 77.6569C87.1571 76.1566 88 74.1217 88 72V36C88 33.8783 87.1571 31.8434 85.6569 30.3431C84.1566 28.8429 82.1217 28 80 28H68L58 16Z</Geometry>
        <Geometry x:Key="CameraPlaceholderLensGeometry">M48 64C54.6274 64 60 58.6274 60 52C60 45.3726 54.6274 40 48 40C41.3726 40 36 45.3726 36 52C36 58.6274 41.3726 64 48 64Z</Geometry>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#94A3B8" />
                                <Setter TargetName="Root" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource InputComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Margin="12,0,8,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />

                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <Path x:Name="ArrowPath"
                                              Data="M4 6L8 10L12 6"
                                              Stroke="{StaticResource SecondaryTextBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,6,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Effect="{StaticResource CardShadowEffect}">
                                    <ScrollViewer Margin="6"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#94A3B8" />
                                <Setter TargetName="ArrowPath" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="8" CenterY="8" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource ModernComboBoxStyle}" />

        <Style x:Key="TabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="14"
                                    Padding="4">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent" />
                            </Border>
                            <ContentPresenter Grid.Row="2"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Margin="2,0"
                                Background="Transparent"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="PlaybackListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="Transparent">
                            <ScrollViewer Padding="0">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaybackListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Padding="14"
                                Background="#F8FAFC"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#94A3B8" />
                                <Setter TargetName="Root" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#0F172A" />
                                <Setter TargetName="Root" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
        <Grid Margin="24"
              MinWidth="1280"
              MinHeight="760">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.05*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="1.08*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="0.92*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="{Binding CameraDisplayName}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"
                                       Text="{Binding CameraStatusText}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="10,4"
                                Background="#ECFDF5"
                                CornerRadius="999">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource SuccessBrush}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#047857"
                                           Text="{Binding MonitorStatusText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            MinHeight="340"
                            CornerRadius="18"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            Background="{StaticResource MonitorBackgroundBrush}">
                        <Grid ClipToBounds="True">
                            <MediaElement x:Name="PlaybackMediaElement"
                                          Stretch="Uniform"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          MediaOpened="PlaybackMediaElement_MediaOpened"
                                          MediaEnded="PlaybackMediaElement_MediaEnded"
                                          MediaFailed="PlaybackMediaElement_MediaFailed" />

                            <Border Height="64"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource MonitorTopMaskBrush}">
                                <Grid Margin="20,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10"
                                                 Height="10"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{StaticResource DangerBrush}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="#FFFFFF"
                                                   FontSize="14"
                                                   Text="REC" />
                                        <Border Margin="12,0,0,0"
                                                Padding="8,3"
                                                Background="#33000000"
                                                CornerRadius="999">
                                            <TextBlock Foreground="#FFFFFF"
                                                       FontSize="12"
                                                       Text="{Binding CameraDisplayName}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Foreground="#FFFFFF"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               Text="{Binding MonitorTimestamp}" />
                                </Grid>
                            </Border>

                            <StackPanel x:Name="PlaceholderPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Viewbox Width="110" Height="110">
                                    <Grid Width="96" Height="96">
                                        <Path Data="{StaticResource CameraPlaceholderOuterGeometry}"
                                              Stroke="#66FFFFFF"
                                              StrokeThickness="8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                        <Path Data="{StaticResource CameraPlaceholderLensGeometry}"
                                              Stroke="#66FFFFFF"
                                              StrokeThickness="8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Margin="0,14,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="#DDE7F3"
                                           FontSize="16"
                                           Text="请选择日期和录像开始回放" />
                            </StackPanel>

                            <Border Height="74"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource MonitorBottomMaskBrush}">
                                <Grid Margin="20,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource MonitorInfoBrush}"
                                                   FontSize="13"
                                                   Text="{Binding VideoSpecText}" />
                                        <Border Width="1"
                                                Height="16"
                                                Margin="12,0"
                                                Background="#55FFFFFF" />
                                        <TextBlock Foreground="{StaticResource MonitorInfoBrush}"
                                                   FontSize="13"
                                                   Text="{Binding StreamBitrateText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Foreground="{StaticResource MonitorInfoBrush}"
                                               FontSize="13"
                                               Text="{Binding PlaybackStateText}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4"
                            Style="{StaticResource CardStyle}"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="录像回放" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="13"
                                               Text="{Binding PlaybackSelectionSummary}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               Text="{Binding PlaybackHintText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="刷新录像"
                                        Command="{Binding RefreshRecordedFilesCommand}" />
                            </Grid>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.02*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1.18*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="按日期选择录像" />
                                    <DatePicker Height="38"
                                                SelectedDate="{Binding SelectedPlaybackDate, Mode=TwoWay}" />

                                    <TextBlock Margin="0,16,0,6"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="当天录像列表" />
                                    <ListBox MinHeight="210"
                                             MaxHeight="360"
                                             ItemsSource="{Binding RecordedFiles}"
                                             SelectedItem="{Binding SelectedRecording, Mode=TwoWay}"
                                             Style="{StaticResource PlaybackListBoxStyle}"
                                             ItemContainerStyle="{StaticResource PlaybackListBoxItemStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding DisplayName}" />
                                                    <TextBlock Margin="0,5,0,0"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="12"
                                                               Text="{Binding SummaryText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedRecordingTitle}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               Text="{Binding SelectedRecordingSummaryText}"
                                               TextWrapping="Wrap" />

                                    <UniformGrid Margin="0,18,0,0"
                                                 Columns="4">
                                        <Button Margin="0,0,8,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="快退10秒"
                                                IsEnabled="{Binding HasSelectedRecording}"
                                                Click="SeekBackwardButton_Click" />
                                        <Button Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="开始播放"
                                                IsEnabled="{Binding HasSelectedRecording}"
                                                Click="StartPlaybackButton_Click" />
                                        <Button Margin="0,0,8,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="暂停"
                                                IsEnabled="{Binding HasSelectedRecording}"
                                                Click="PausePlaybackButton_Click" />
                                        <Button
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="快进10秒"
                                                IsEnabled="{Binding HasSelectedRecording}"
                                                Click="SeekForwardButton_Click" />
                                    </UniformGrid>

                                    <Slider x:Name="PlaybackProgressSlider"
                                            Margin="0,18,0,0"
                                            Minimum="0"
                                            Maximum="{Binding PlaybackDurationSeconds}"
                                            Value="{Binding PlaybackProgressSeconds, Mode=TwoWay}"
                                            IsEnabled="{Binding HasSelectedRecording}"
                                            PreviewMouseLeftButtonDown="PlaybackProgressSlider_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="PlaybackProgressSlider_PreviewMouseLeftButtonUp" />

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Text="{Binding PlaybackCurrentTimeText}" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Text="{Binding PlaybackDurationText}" />
                                    </Grid>

                                    <Border Margin="0,16,0,0"
                                            Padding="12"
                                            Background="#F8FAFC"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Margin="0,0,0,8"
                                                       Text="当前回放文件" />
                                            <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Text="{Binding SelectedRecordingPathText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="录像目录" />
                        </StackPanel>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="录像储存路径" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding StoragePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Border Margin="0,18,0,0"
                                    Padding="14"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="已扫描录像数" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding TotalRecordedFileCountText}" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="13"
                                                   Text="存在录像的日期" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding RecordedDateCountText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0"
                                    Padding="14"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,0,0,8"
                                               Text="最近录像" />
                                    <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="13"
                                               Text="{Binding LatestRecordedFileText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0"
                                    Padding="14"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,0,0,8"
                                               Text="支持格式" />
                                    <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Text="{Binding SupportedFormatText}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,16,0,0"
                                    Padding="14"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,0,0,8"
                                               Text="回放说明" />
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               Text="1. 修改录像储存路径 2. 点击左侧刷新录像 3. 选择日期和录像 4. 使用开始 暂停 快进 快退 和拖动进度条回放"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="4"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="重新扫描当前路径"
                            Command="{Binding RefreshRecordedFilesCommand}" />
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
