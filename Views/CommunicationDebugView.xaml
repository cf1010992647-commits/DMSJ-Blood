<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Blood_Alcohol.Views.CommunicationDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Blood_Alcohol.ViewModels"
             FontFamily="Segoe UI, Microsoft YaHei">

    <UserControl.DataContext>
        <vm:CommunicationViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <DropShadowEffect x:Key="SoftCardShadow"
                          BlurRadius="18"
                          ShadowDepth="6"
                          Direction="270"
                          Color="#D6DAE2"
                          Opacity="0.35" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E3E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect" Value="{StaticResource SoftCardShadow}" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#737D8C" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D4DBE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#F2F4F8" />
                                <Setter Property="Foreground" Value="#9AA3B2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D4DBE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0B7FF3" />
            <Setter Property="BorderBrush" Value="#0B7FF3" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#006FE0" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#006FE0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#005FC2" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#005FC2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#B8C4D6" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#B8C4D6" />
                                <Setter Property="Foreground" Value="#EEF2F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D4DBE6" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F4F7FB" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#C9D2DF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EAF1FA" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#B9C6D8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#F2F4F8" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#DDE3EC" />
                                <Setter Property="Foreground" Value="#9AA3B2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F7FB" />
                    <Setter Property="BorderBrush" Value="#C9D2DF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EAF1FA" />
                    <Setter Property="BorderBrush" Value="#B9C6D8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="TcpDeviceGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF1F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="32" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F4F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E8EDF4"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="通讯调试"
                               Foreground="#111827"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="配置 RS485 / TCP 服务 / 设备端口映射 / 在线诊断"
                               Foreground="#8A93A3"
                               FontSize="12"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="24,2,0,0">
                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,5"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Fill="{Binding Rs485StatusColor}" Style="{StaticResource StatusDotStyle}" />
                            <TextBlock Text="RS485"
                                       Foreground="#475569"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Fill="{Binding TcpStatusColor}" Style="{StaticResource StatusDotStyle}" />
                            <TextBlock Text="TCP"
                                       Foreground="#475569"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="520" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.05*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Ellipse Fill="{Binding Rs485StatusColor}"
                                             Style="{StaticResource StatusDotStyle}"
                                             Margin="0,0,8,0" />
                                    <StackPanel>
                                        <TextBlock Text="RS485 通讯" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="串口、波特率与 PLC 站号" Style="{StaticResource SectionHintStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="串口 (COM)"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox Grid.Row="2"
                                              Grid.Column="0"
                                              ItemsSource="{Binding AvailableComPorts}"
                                              SelectedItem="{Binding SelectedComPort}"
                                              Style="{StaticResource ModernComboBoxStyle}" />

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="2"
                                               Text="波特率"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox Grid.Row="2"
                                              Grid.Column="2"
                                              ItemsSource="{Binding AvailableBaudRates}"
                                              SelectedItem="{Binding SelectedBaudRate}"
                                              Style="{StaticResource ModernComboBoxStyle}" />

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               Text="PLC 站号"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <StackPanel Grid.Row="6"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <TextBox Width="140"
                                                 Text="{Binding SelectedPlcSlaveAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBoxStyle}" />
                                        <Button Content="{Binding Rs485ButtonText}"
                                                Command="{Binding ToggleRs485Command}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                MinWidth="96"
                                                Margin="12,0,0,0" />
                                        <Button Content="刷新端口"
                                                Command="{Binding RefreshComPortsCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                MinWidth="96"
                                                Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="TCP 服务" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="启动本机监听服务并接收设备连接" Style="{StaticResource SectionHintStyle}" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="监听端口"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <StackPanel Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <TextBox Width="140"
                                                 Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBoxStyle}" />
                                        <Button Content="{Binding TcpButtonText}"
                                                Command="{Binding ToggleTcpCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                MinWidth="128"
                                                Margin="12,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="TCP 设备绑定信息" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="维护端口、设备类型、设备标识与客户端 IP 映射" Style="{StaticResource SectionHintStyle}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="空白行可直接新增"
                                           Foreground="#8A93A3"
                                           FontSize="12"
                                           VerticalAlignment="Top"
                                           Margin="16,2,0,0" />
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding TcpDevices}"
                                      AutoGenerateColumns="False"
                                      Height="230"
                                      IsReadOnly="False"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="True"
                                      Style="{StaticResource TcpDeviceGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="端口"
                                                        Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="90" />
                                    <DataGridTextColumn Header="设备类型"
                                                        Binding="{Binding DeviceType, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="120" />
                                    <DataGridTextColumn Header="设备标识"
                                                        Binding="{Binding DeviceKey, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="150" />
                                    <DataGridTextColumn Header="客户端 IP"
                                                        Binding="{Binding ClientIp, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Grid.Row="4"
                                    Content="保存配置"
                                    Command="{Binding SaveTcpConfigCommand}"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="112" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="在线诊断" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="快速验证 PLC、温控、扫码枪与地磅设备通讯链路" Style="{StaticResource SectionHintStyle}" />

                            <UniformGrid Columns="4" Margin="0,16,0,0">
                                <Button Content="测试 PLC"
                                        Command="{Binding TestPlcCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,6,0" />
                                <Button Content="测试温度传感器"
                                        Command="{Binding TestTemperatureCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="3,0,6,0" />
                                <Button Content="测试扫码枪"
                                        Command="{Binding TestScannerCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="3,0,6,0" />
                                <Button Content="测试天平设备"
                                        Command="{Binding TestWeightCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="3,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Border Grid.Column="2"
                    Background="#1F1F1F"
                    BorderBrush="#262B33"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="通讯日志"
                                   Foreground="#F8FAFC"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="最近 300 条"
                                   Foreground="#8A93A3"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Logs}"
                             BorderThickness="0"
                             Background="#1F1F1F"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#D1D5DB"
                                           TextWrapping="Wrap">
                                    <Run Text="[" />
                                    <Run Text="{Binding Time}" />
                                    <Run Text="] " />
                                    <Run Text="{Binding Message}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
